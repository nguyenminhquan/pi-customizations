{
  "name": "@nguyenminhquan/pi-customizations",
  "version": "0.1.0",
  "description": "Personal Pi extensions and themes, including Slate UI and six accent palettes.",
  "type": "module",
  "license": "MIT",
  "author": "Minh Quan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenminhquan/pi-customizations.git"
  },
  "homepage": "https://github.com/nguyenminhquan/pi-customizations#readme",
  "bugs": "https://github.com/nguyenminhquan/pi-customizations/issues",
  "keywords": ["pi-package", "pi", "extensions", "themes", "slate-ui"],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": ["extensions", "themes", "docs", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./extensions/*.ts", "./extensions/*/index.ts"],
    "themes": ["./themes/*.json"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "22.19.19",
    "typescript": "~5.9.3"
  }
}
